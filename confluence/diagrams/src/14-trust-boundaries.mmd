flowchart LR
    subgraph Z1["SECRET STORE"]
        S1@{ icon: "mdi:shield-key", form: "square", label: "Kubernetes Secret<br/>BARCLAYS_AI_BAM_*", pos: "b", h: 46 }
    end
    subgraph Z2["RUNTIME POD · MEMORY ONLY"]
        direction TB
        P1["<b>BamTokenClient</b><br/>holds the Basic credentials"]
        P2["<b>BamTokenCache</b><br/>holds the current token"]
        P3["<b>Logs</b><br/>header names · hosts · status<br/>never values or bodies"]
    end
    subgraph Z3["BPMN + ZEEBE · NO SECRETS"]
        E1["<b>AI Agent element</b><br/>region · model · custom endpoint"]
    end
    subgraph Z4["BARCLAYS NETWORK"]
        direction TB
        N1@{ icon: "logos:jwt-icon", form: "square", label: "BAM<br/>https only · no redirects", pos: "b", h: 46 }
        N2@{ icon: "logos:aws-api-gateway", form: "square", label: "Bedrock gateway<br/>verifies x-bam-token", pos: "b", h: 46 }
    end
    S1 -->|"env vars at startup"| P1
    P1 -->|"Basic auth over TLS"| N1
    N1 -->|"bamToken"| P2
    P2 ==>|"token on every request"| N2
    E1 -.->|"custom endpoint URL decides<br/>where the token is sent"| N2
    E1 -.-> RISK["<b>Not a control</b><br/>no allow-list: any URL on the element<br/>receives the token"]
    P1 ~~~ P3

