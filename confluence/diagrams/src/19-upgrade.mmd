flowchart TD
    BUMP["<b>1 · Bump version.connectors</b><br/>align version.spring-boot"] --> JAVAP["<b>2 · javap the new classes</b><br/>ChatModelFactoryImpl<br/>ChatModelHttpProxySupport"]
    JAVAP --> DIFF{"Copied Bedrock setup<br/>changed upstream?"}
    DIFF -->|"yes"| PORT["Port the change into<br/><b>CamundaBedrockClientParity</b>"] --> VERIFY
    DIFF -->|"no"| VERIFY{"<b>3 · ./mvnw verify</b><br/>green?"}
    VERIFY -->|"no"| FIX["Read the failing tripwire test<br/>and adapt"] --> VERIFY
    VERIFY -->|"yes"| REGEN["<b>4 · Regenerate element templates</b><br/>review the diff"]
    REGEN --> SHIP(["Republish templates<br/>roll out the runtime"])

