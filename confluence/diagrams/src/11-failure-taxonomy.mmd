flowchart LR
    E(("Something<br/>failed"))
    E --> P["<b>Permanent</b><br/>BarclaysAuthenticationException<br/><i>extends NonRetriableException</i>"]
    E --> T["<b>Transient</b><br/>BarclaysAuthenticationUnavailableException<br/><i>extends LangChain4jException</i>"]
    E --> O["<b>Not ours</b><br/>LLM 4xx · gateway 5xx · timeouts"]
    P --> PR["TOKEN_REQUEST_REJECTED<br/>MALFORMED_TOKEN_RESPONSE<br/>TOKEN_SOURCE_FAILED<br/>GATEWAY_REJECTED_CREDENTIALS<br/>GATEWAY_ACCESS_DENIED<br/>ENDPOINT_NOT_CONFIGURED"]
    T --> TR["TOKEN_ENDPOINT_TIMEOUT<br/>TOKEN_ENDPOINT_UNREACHABLE<br/>TOKEN_ENDPOINT_ERROR<br/>INTERRUPTED"]
    PR -->|"never retried by LangChain4j"| AD
    TR -->|"no cause · sanitized message"| AD
    O -->|"rethrown unchanged"| AD
    AD["<b>Langchain4JAiFrameworkAdapter</b><br/>ConnectorException · FAILED_MODEL_CALL"] --> INC(["Camunda job retries → incident<br/>same semantics as the standard connector"])

    %% palette (shared by every diagram; see render.py LEGEND)
    classDef cam   fill:#EEF3FB,stroke:#3B6FD8,stroke-width:1.5px,color:#16325E
    classDef ours  fill:#FFF1E6,stroke:#F07A1A,stroke-width:2px,color:#6B2F00
    classDef ext   fill:#EAF7EF,stroke:#22A05A,stroke-width:1.5px,color:#0D4A2A
    classDef bad   fill:#FDECEE,stroke:#D8414F,stroke-width:1.5px,color:#7A1420
    classDef cfg   fill:#F1ECFF,stroke:#7A5AF0,stroke-width:1.5px,color:#33207A
    classDef ghost fill:#F6F7F9,stroke:#B6BFCC,stroke-width:1px,stroke-dasharray:4 3,color:#6A7385
    classDef navy  fill:#16253D,stroke:#16253D,stroke-width:1.5px,color:#FFFFFF
    classDef icon  fill:#FFFFFF,stroke:#D5DDE8,stroke-width:1px,color:#16253D

    class E navy
