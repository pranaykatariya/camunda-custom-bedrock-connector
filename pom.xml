<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.barclays.groupcontrol.co.camunda</groupId>
  <artifactId>barclays-ai-agent-connector-runtime</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Barclays AI Agent Connector Runtime</name>
  <description>
    Extension jar for the Camunda 8.9 connector runtime: Barclays-specific authentication for the
    standard AI Agent connector's AWS Bedrock provider through the Barclays Bedrock gateway.
  </description>

  <properties>
    <!--
      Single source of truth for the Camunda connectors version. Upgrading Camunda = changing this
      one property (see docs/UPGRADING.md). Every transitive version (Spring Boot, LangChain4j,
      Jackson, ...) is taken from Camunda's own connector-parent BOM for this version, so this
      runtime never upgrades a dependency that Camunda did not test with.
    -->
    <version.connectors>8.9.12</version.connectors>

    <!-- Must match the version managed by connector-parent (used only for the annotation processor). -->
    <version.spring-boot>4.1.1</version.spring-boot>

    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.camunda.connector</groupId>
        <artifactId>connector-parent</artifactId>
        <version>${version.connectors}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Official Camunda connector runtime (Spring Boot) -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>spring-boot-starter-camunda-connectors</artifactId>
      <version>${version.connectors}</version>
      <!-- Provided by the Camunda connector runtime. -->
      <scope>provided</scope>
    </dependency>

    <!-- Official Camunda AI Agent connector (unmodified) -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-agentic-ai</artifactId>
      <version>${version.connectors}</version>
      <!-- Provided by the Camunda connector runtime. -->
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${version.spring-boot}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- Integration tests (*IT) run in the same phase: they need no external services. -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
